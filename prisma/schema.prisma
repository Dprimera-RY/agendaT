// Prisma schema - Agenda de Citas Multi-Negocio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================
// USUARIOS Y AUTENTICACIÓN
// ============================================================

model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessOwner {
  id              String    @id @default(cuid())
  username        String    @unique
  password        String
  name            String
  email           String?
  phone           String? // WhatsApp del dueño
  emailVerified   Boolean   @default(false) // verificación de identidad por email (OTP)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  businesses Business[]
}

// Códigos OTP de verificación de email (registro y recuperación de contraseña)
model EmailOtp {
  id        String   @id @default(cuid())
  email     String
  code      String // 6 dígitos
  purpose   String // register | reset
  ownerId   String? // dueño asociado (si aplica)
  attempts  Int      @default(0)
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
}

// ============================================================
// CATÁLOGO
// ============================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique // Peluquería, Barbería, Spa, Dentista, etc.
  slug        String   @unique
  icon        String?  // nombre de icono Lucide
  description String?
  createdAt   DateTime @default(now())

  businesses Business[]
}

model Business {
  id        String   @id @default(cuid())
  slug      String   @unique // nombre-negocio en URL
  name      String
  description String?
  logo      String?  // URL o base64
  photo1    String?  // foto de trabajo 1
  photo2    String?  // foto de trabajo 2
  photo3    String?  // foto de trabajo 3
  address   String?
  province  String?  // Provincia de Cuba (select; incluye Isla de la Juventud)
  phone     String?
  email     String?
  ownerId   String
  categoryId String
  certified  Boolean  @default(false) // certificación verificada (marca junto al nombre)
  certifiedAt DateTime?
  depositEnabled Boolean @default(false) // el negocio exige depósito para confirmar cita
  depositAmount  Float   @default(0) // monto del depósito (CUP)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner        BusinessOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  category     Category      @relation(fields: [categoryId], references: [id])
  license      License?
  services     Service[]
  appointments Appointment[]
  availabilities Availability[]
  visits       Visit[]
  reviews      Review[]
  paymentCodes PaymentCode[]
}

model License {
  id          String   @id @default(cuid())
  businessId  String   @unique
  startDate   DateTime
  endDate     DateTime
  durationDays Int     // duración total de la licencia en días
  active      Boolean  @default(true)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// ============================================================
// SERVICIOS Y CITAS
// ============================================================

model Service {
  id          String   @id @default(cuid())
  businessId  String
  name        String
  description String?
  price       Float
  currency    String   @default("CUP") // moneda del precio, editable por el dueño
  durationMin Int      @default(30) // duración en minutos
  color       String?  // color hex (#rrggbb) para el calendario del dueño
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  business     Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

// Configuración global de la app (clave-valor). Editable solo por el admin.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Planes/suscripciones ofrecidos (precios editables desde el admin)
model Plan {
  id           String   @id @default(cuid())
  name         String   // "Mensual", "Anual", ...
  durationDays Int      // duración de la suscripción en días
  price        Int      // precio en CUP
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Código de pago de 6 dígitos que genera el dueño al elegir un plan;
// el asesor (admin) lo utiliza para aplicar el pago de la suscripción.
// kind: "plan" (renueva licencia) | "certificacion" (certifica el negocio).
model PaymentCode {
  id           String   @id @default(cuid())
  code         String   @unique // 6 dígitos
  businessId   String
  planId       String
  planName     String   // nombre del plan al momento de generar (referencia)
  price        Int      // precio en CUP al momento de generar
  durationDays Int
  kind         String   @default("plan") // plan | certificacion
  status       String   @default("pendiente") // pendiente | pagada | rechazada
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([status])
}

// Suscripción Web Push (service worker). targetType: owner | customer
model PushSubscription {
  id         String   @id @default(cuid())
  endpoint   String   @unique
  p256dh     String
  auth       String
  targetType String   // "owner" | "customer"
  targetId   String   // ownerId o customerHash
  businessId String?  // opcional: filtro por negocio
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
}

model Appointment {
  id          String   @id @default(cuid())
  businessId  String
  serviceId   String
  customerName String
  customerPhone String  // WhatsApp del cliente
  customerEmail String?
  customerHash String?  // hash anónimo del cliente (localStorage) para "mis citas"
  date        DateTime // fecha y hora exacta
  status      String   @default("pendiente") // pendiente | confirmada | cancelada | completada
  notes       String?
  depositPaid Boolean  @default(false)
  depositAmount Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service @relation(fields: [serviceId], references: [id])

  @@index([customerHash])
}

// Reseña anónima: una por (negocio, hash de cliente). Sin registro de usuario.
model Review {
  id           String   @id @default(cuid())
  businessId   String
  customerHash String
  customerName String?  // nombre que decidió mostrar el cliente
  rating       Int      // 1..5
  comment      String?
  createdAt    DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, customerHash])
  @@index([businessId])
}

// ============================================================
// DISPONIBILIDAD
// ============================================================

model Availability {
  id          String   @id @default(cuid())
  businessId  String
  dayOfWeek   Int      // 0=Dom, 1=Lun, ..., 6=Sab
  startTime   String   // "09:00"
  endTime     String   // "17:00"
  breakStart  String?  // inicio del horario de no atención (almuerzo), opcional "12:00"
  breakEnd    String?  // fin del horario de no atención "13:00"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// Bloqueos de horario específicos (vacaciones, días libres puntuales)
model TimeBlock {
  id          String   @id @default(cuid())
  businessId  String
  startDate   DateTime
  endDate     DateTime
  reason      String?
  createdAt   DateTime @default(now())
}

// Visitas a la página pública de un negocio (para métricas del admin)
model Visit {
  id         String   @id @default(cuid())
  businessId String
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
}
